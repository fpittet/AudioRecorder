<Window x:Class="AudioRecorder.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Journal d'activité"
        Height="560" MinHeight="400"
        Width="1180" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0F">

    <Window.Resources>
        <!-- Style DataGrid sombre -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"           Value="#0D0D0F"/>
            <Setter Property="Foreground"           Value="#C8C8E0"/>
            <Setter Property="BorderBrush"          Value="#1A1A2E"/>
            <Setter Property="BorderThickness"      Value="1"/>
            <Setter Property="GridLinesVisibility"  Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1A1A2E"/>
            <Setter Property="RowBackground"        Value="#0D0D0F"/>
            <Setter Property="AlternatingRowBackground" Value="#12121A"/>
            <Setter Property="HeadersVisibility"    Value="Column"/>
            <Setter Property="SelectionMode"        Value="Single"/>
            <Setter Property="SelectionUnit"        Value="FullRow"/>
            <Setter Property="AutoGenerateColumns"  Value="False"/>
            <Setter Property="CanUserAddRows"       Value="False"/>
            <Setter Property="CanUserDeleteRows"    Value="False"/>
            <Setter Property="IsReadOnly"           Value="True"/>
            <Setter Property="FontFamily"           Value="Consolas"/>
            <Setter Property="FontSize"             Value="11"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#06060B"/>
            <Setter Property="Foreground"      Value="#7878A0"/>
            <Setter Property="BorderBrush"     Value="#1A1A2E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Foreground"      Value="#C8C8E0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A2E1A"/>
                    <Setter Property="Foreground" Value="#2ECC71"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A2E1A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14141C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#06060B"
                BorderBrush="#1A1A2E" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="JOURNAL D'ACTIVITÉ"
                               FontFamily="Segoe UI Light" FontSize="16"
                               Foreground="White"/>
                    <TextBlock x:Name="TxtLogPath"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#505068" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtEntryCount"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#707088"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="LogGrid" Grid.Row="1" Margin="0">
            <DataGrid.Columns>

                <DataGridTextColumn Header="DATE / HEURE"
                                    Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yy HH:mm:ss}}"
                                    Width="130" MinWidth="100"/>

                <DataGridTextColumn Header="ACTION"
                                    Binding="{Binding Action}"
                                    Width="160" MinWidth="120"/>

                <DataGridTextColumn Header="SOURCE"
                                    Binding="{Binding Source}"
                                    Width="80" MinWidth="60"/>

                <DataGridTextColumn Header="FICHIER"
                                    Binding="{Binding FileNameOnly}"
                                    Width="180" MinWidth="100"/>

                <DataGridTextColumn Header="DURÉE"
                                    Binding="{Binding DurationFmt}"
                                    Width="70" MinWidth="60"/>

                <DataGridTextColumn Header="TRAITEMENT"
                                    Binding="{Binding ProcessingFmt}"
                                    Width="90" MinWidth="70"/>

                <DataGridTextColumn Header="MOTS"
                                    Binding="{Binding WordsFmt}"
                                    Width="60" MinWidth="50"/>

                <DataGridTextColumn Header="MODE"
                                    Binding="{Binding Mode}"
                                    Width="70" MinWidth="60"/>

                <DataGridTextColumn Header="LANG.IN"
                                    Binding="{Binding InputLang}"
                                    Width="65" MinWidth="55"/>

                <DataGridTextColumn Header="LANG.OUT"
                                    Binding="{Binding OutputLang}"
                                    Width="80" MinWidth="65"/>

                <DataGridTextColumn Header="DÉTAIL"
                                    Binding="{Binding Detail}"
                                    Width="*" MinWidth="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pied de page -->
        <Border Grid.Row="2" Background="#06060B"
                BorderBrush="#1A1A2E" BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fermer" Click="BtnClose_Click"
                        Padding="20,8" Cursor="Hand"
                        Background="#1E3A5F" Foreground="White"
                        BorderBrush="#2E5A8F" BorderThickness="1"
                        FontFamily="Segoe UI" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
