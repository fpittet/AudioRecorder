<Window x:Class="AudioRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Recorder"
        Height="980" MinHeight="760"
        Width="700"   MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0D0D0F">

    <Window.Resources>

        <!-- Bouton rond principal -->
        <Style x:Key="RecordButton" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="MainCircle" Width="80" Height="80"
                                     Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainCircle" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainCircle" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainCircle" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton source (toggle) -->
        <Style x:Key="SourceButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A40"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2E1A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2ECC71"/>
                                <Setter Property="Foreground" Value="#2ECC71"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A6E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label secondaire -->
        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#C0C0C0"/>
        </Style>

        <!-- Bouton toggle petit (mode transcription) -->
        <Style x:Key="TranscribeButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A40"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2E1A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2ECC71"/>
                                <Setter Property="Foreground" Value="#2ECC71"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A6E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton d'action (résumer) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2E5A8F"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A5080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#152840"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0 : En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- 1 : Source -->
            <RowDefinition Height="Auto"/>
            <!-- 2 : Boutons Start/Stop -->
            <RowDefinition Height="Auto"/>
            <!-- 3 : Vumètre + timer -->
            <RowDefinition Height="Auto"/>
            <!-- 4 : Pied de page fichier -->
            <RowDefinition Height="Auto"/>
            <!-- 5 : Contrôles transcription -->
            <RowDefinition Height="Auto"/>
            <!-- 6 : Boutons résumé -->
            <RowDefinition Height="*"/>
            <!-- 7 : Zone texte résumé -->
            <RowDefinition Height="Auto"/>
            <!-- 8 : Barre statistiques -->
        </Grid.RowDefinitions>

        <!-- ─── En-tête ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="40,26,40,0">
            <TextBlock Text="AUDIO RECORDER"
                       FontFamily="Segoe UI Light" FontSize="22" FontWeight="Light"
                       Foreground="White"/>
            <TextBlock Text="WINDOWS 11  ·  MP3 320 kbps"
                       FontFamily="Segoe UI" FontSize="10"
                       Foreground="#C0C0C0" Margin="2,6,0,0"/>
        </StackPanel>

        <!-- ─── Sélecteur de source ─────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="40,12,40,0">
            <TextBlock Text="SOURCE D'ENTRÉE"
                       Style="{StaticResource SubLabel}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbLoopback"
                             Style="{StaticResource SourceButton}" IsChecked="True" Margin="0,0,10,0" Width="158">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎧" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SORTIE CASQUE" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RbMicrophone"
                             Style="{StaticResource SourceButton}" Margin="0,0,10,0" Width="147">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎤" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="MICROPHONE" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RbBoth"
                             Style="{StaticResource SourceButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎤+🎧" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="LES DEUX" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </StackPanel>

        <!-- ─── Boutons START / STOP ─────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="40,20,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnStart"
                        Style="{StaticResource RecordButton}"
                        Background="#2ECC71"
                        Click="BtnStart_Click"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="&#x25CF;" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="START" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="DÉMARRER"
                           Style="{StaticResource SubLabel}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Height="80"
                       Fill="#1E1E2E" VerticalAlignment="Center" Margin="20,0"/>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnStop"
                        Style="{StaticResource RecordButton}"
                        Background="#E74C3C"
                        Click="BtnStop_Click"
                        IsEnabled="False"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="&#x25A0;" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="STOP" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="ARRÊTER ET SAUVEGARDER"
                           Style="{StaticResource SubLabel}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ─── Vumètre + timer ─────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Margin="40,20,40,0">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus"
                           Text="EN ATTENTE"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="#C0C0C0" VerticalAlignment="Center"/>
                <!-- ─ Arrêt automatique ──────────────────────────────── -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="ARRÊT AUTO [minutes]"
                               FontFamily="Segoe UI" FontSize="9"
                               Foreground="#C0C0C0" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtDuration"
                             Width="76" Height="26"
                             Background="#12121A" Foreground="#F0F0F0"
                             CaretBrush="#F0F0F0"
                             BorderBrush="#2A2A40" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             ToolTip="Durée d'arrêt automatique : hh:mm:ss ou mm:ss ou minutes (ex: 30:00). Vide = arrêt manuel."/>
                </StackPanel>
                <TextBlock x:Name="TxtTimer"
                           Grid.Column="2" Text="00:00:00"
                           FontFamily="Consolas" FontSize="22"
                           Foreground="#2ECC71" FontWeight="Bold"/>
            </Grid>
            <TextBlock Text="NIVEAU D'ENTRÉE"
                       Style="{StaticResource SubLabel}" Margin="0,0,0,8"/>
            <Border x:Name="VuBorder"
                    Background="#12121A" CornerRadius="4" Height="28" ClipToBounds="True">
                <Grid>
                    <Rectangle Fill="#0A0A14"/>
                    <Rectangle x:Name="VuMeter"
                               HorizontalAlignment="Left" Width="0" Height="28"
                               RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2ECC71" Offset="0"/>
                                <GradientStop Color="#F1C40F" Offset="0.7"/>
                                <GradientStop Color="#E74C3C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="-18" Foreground="#606080" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="-9"  Foreground="#606080" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="3" Text="0 dB" Foreground="#606080" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ─── Pied de page fichier ─────────────────────────────────────── -->
        <Border Grid.Row="4" Margin="0,20,0,0" Background="#09090E" Padding="40,14">
            <Grid>
                <TextBlock x:Name="TxtFileInfo"
                           Text="Aucun fichier enregistré"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#C0C0C0" VerticalAlignment="Center"/>
                <TextBlock Text="MP3 · 320 kbps · 44.1 kHz · Stéréo"
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="#C0C0C0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             SECTION TRANSCRIPTION / RÉSUMÉ
             ═══════════════════════════════════════════════════════════════ -->

        <!-- Contrôles transcription : langue + mode -->
        <StackPanel Grid.Row="5" Margin="40,22,40,0">
            <TextBlock Text="TRANSCRIPTION  ·  RÉSUMÉ"
                       FontFamily="Segoe UI Light" FontSize="13" FontWeight="Light"
                       Foreground="#C0C0C0"/>
            <StackPanel Margin="0,14,0,0">

                <!-- ── Langue audio + bouton Ouvrir MP3 ──────────────── -->
                <TextBlock Text="LANGUE AUDIO                                                                                   MODE DE TRANSCRIPTION"
                           Style="{StaticResource SubLabel}" Margin="0,0,0,8" Height="19" Width="610"/>
                <StackPanel Orientation="Horizontal" Width="616">
                    <Button x:Name="BtnOpenMp3"
                            Style="{StaticResource ActionButton}"
                            Content="Ouvrir MP3…"
                            Click="BtnOpenMp3_Click"
                            Background="#0D2A2A" BorderBrush="#1A5A5A"
                            Height="34"/>
                    <ComboBox x:Name="CbAudioLang"
                              Width="150" Height="34" Margin="10,0,0,0"
                              Background="White" Foreground="Black"
                              BorderBrush="#AAAACC"
                              FontFamily="Segoe UI" FontSize="12">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="Anglais (English)" Tag="en" IsSelected="True"/>
                        <ComboBoxItem Content="Français" Tag="fr"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Width="240" Margin="50,0,0,0">
                        <RadioButton x:Name="RbTranscribeLocal"
                                 Style="{StaticResource TranscribeButton}"
                                 Content="Local (Whisper)"
                                 IsChecked="True" Margin="0,0,8,0" Width="100"/>
                        <RadioButton x:Name="RbTranscribeRemote"
                                 Style="{StaticResource TranscribeButton}"
                                 Content="Infomaniak (distant)"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Mode de transcription (sous langue) ───────────── -->

            </StackPanel>
        </StackPanel>

        <!-- Résumé : sélecteur de langue + bouton -->
        <StackPanel Grid.Row="6" Margin="40,14,40,0" Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBlock Text="RÉSUMÉ EN"
                       FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                       Foreground="#C0C0C0" VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox x:Name="CbOutputLang"
                      Width="130" Height="34"
                      Background="White" Foreground="Black"
                      BorderBrush="#AAAACC"
                      FontFamily="Segoe UI" FontSize="12"
                      Margin="0,0,10,0"
                      SelectionChanged="CbOutputLang_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="English"  Tag="anglais"/>
                <ComboBoxItem Content="Français" Tag="français"  IsSelected="True"/>
            </ComboBox>
            <Button x:Name="BtnResume"
                    Style="{StaticResource ActionButton}"
                    Content="Résume"
                    Click="BtnResume_Click"
                    IsEnabled="False"/>
        </StackPanel>

        <!-- Zone de texte résumé : fond blanc, texte noir -->
        <Border Grid.Row="7"
                Margin="40,14,40,10"
                Background="White" CornerRadius="6"
                BorderBrush="#BBBBCC" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="TxtSummary"
                         Background="White" Foreground="#111111"
                         CaretBrush="Black" SelectionBrush="#AADDFF"
                         BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"
                         TextWrapping="Wrap" IsReadOnly="True"
                         Padding="14,12"
                         Text="Aucun résumé disponible."
                         VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             BARRE STATISTIQUES (Row 8)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="8" Background="#06060B" Padding="40,12,40,16"
                BorderThickness="0,1,0,0" BorderBrush="#1A1A2E">
            <Grid>
                <!-- Voir le log — ancré en bas à droite -->
                <Button x:Name="BtnShowLog"
                        Style="{StaticResource ActionButton}"
                        Content="Voir le log"
                        Click="BtnShowLog_Click"
                        Background="#2A1A3A" BorderBrush="#5A3A8A"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                <StackPanel>

                    <TextBlock Text="STATISTIQUES"
                           FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                           Foreground="#C0C0C0" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="148"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Enregistrements -->
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Transcriptions label+global -->
                            <RowDefinition Height="Auto"/>
                            <!-- Transcriptions détail -->
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Résumés label+global -->
                            <RowDefinition Height="Auto"/>
                            <!-- Résumés détail -->
                        </Grid.RowDefinitions>

                        <!-- Enregistrements -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="ENREGISTREMENTS"
                               FontFamily="Segoe UI" FontSize="9"
                               Foreground="#505068" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatsRec"
                               Grid.Row="0" Grid.Column="1"
                               Text="0  (durée moy. —)"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#F0F0F0"/>

                        <!-- Transcriptions -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="TRANSCRIPTIONS"
                               FontFamily="Segoe UI" FontSize="9"
                               Foreground="#505068" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatsTrans"
                               Grid.Row="2" Grid.Column="1"
                               Text="0  (moy. — mots, durée —)"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#F0F0F0"/>
                        <TextBlock x:Name="TxtStatsTransDetail"
                               Grid.Row="3" Grid.Column="1"
                               Text="Local: 0 (—)  ·  Remote: 0 (—)"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#C0C0C0"
                               TextWrapping="Wrap"/>

                        <!-- Résumés -->
                        <TextBlock Grid.Row="5" Grid.Column="0"
                               Text="RÉSUMÉS"
                               FontFamily="Segoe UI" FontSize="9"
                               Foreground="#505068" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatsSum"
                               Grid.Row="5" Grid.Column="1"
                               Text="0  (moy. — mots, durée —)"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#F0F0F0"/>
                        <TextBlock x:Name="TxtStatsSumDetail"
                               Grid.Row="6" Grid.Column="1"
                               Text="vers FR: 0 (—)  ·  vers EN: 0 (—)"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#C0C0C0"
                               TextWrapping="Wrap"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
